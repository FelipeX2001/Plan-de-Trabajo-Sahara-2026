rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['name', 'frequency', 'importance', 'responsible', 'status', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 1000 &&
        data.frequency is string && data.frequency.size() > 0 && data.frequency.size() <= 100 &&
        data.importance is string && data.importance in ['Alta', 'Media', 'Baja'] &&
        data.responsible is string && data.responsible.size() > 0 && data.responsible.size() <= 100 &&
        data.status is string && data.status in ['Pendiente', 'En progreso', 'Completado'] &&
        (data.createdAt == request.time || (data.createdAt is string && data.createdAt.size() > 0)) &&
        (!('indicator' in data) || data.indicator == null || (data.indicator is string && data.indicator.size() <= 500)) &&
        (!('date' in data) || data.date == null || (data.date is string && data.date.size() <= 100)) &&
        (!('observations' in data) || data.observations == null || (data.observations is string && data.observations.size() <= 2000));
    }

    match /tasks/{taskId} {
      allow read: if true; // Public dashboard
      // Allow any user to act as admin since login is handled locally
      allow create: if isValidId(taskId) && isValidTask(incoming());
      allow update: if isValidId(taskId) && isValidTask(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(taskId);
    }
  }
}
